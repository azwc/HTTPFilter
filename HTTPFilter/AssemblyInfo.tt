<#@ template language="C#" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.IO" #>
using System.Reflection;
using System.Runtime.InteropServices;
using System.Windows;

[assembly: ThemeInfo(
    ResourceDictionaryLocation.None, //where theme specific resource dictionaries are located
    //(used if a resource is not found in the page,
    // or application resource dictionaries)
    ResourceDictionaryLocation.SourceAssembly //where the generic resource dictionary is located
    //(used if a resource is not found in the page,
    // app, or any theme specific resource dictionaries)
)]

[assembly: Guid("ee0d64fe-0edc-47a2-8148-35690947f337")]
[assembly: AssemblyVersion("1.0.1.<#=RevisionNumber #>>")]

<#
    _file.Write(RevisionNumber);
#>
<#+
    int RevisionNumber = (int)(DateTime.UtcNow - new DateTime(2023,5,17)).TotalDays;
    static string _path = Path.Combine(Environment.CurrentDirectory, "version.txt");
    private StreamWriter _file = File.CreateText(_path);
#>